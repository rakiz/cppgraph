--- a/indexer/ScipExtras.cc
+++ b/indexer/ScipExtras.cc
@@ -114,2 +114,8 @@ void SymbolInformationBuilder::finish(bool deterministic,
       }));
+
+  if (!this->signatureDocumentation.empty()) {
+    auto *sigDoc = out.mutable_signature_documentation();
+    sigDoc->set_language(scip::Language_Name(scip::Language::CPP));
+    sigDoc->set_text(this->signatureDocumentation);
+  }
 }
@@ -191,2 +197,10 @@ void DocumentBuilder::merge(scip::Document &&doc) {
       this->symbolInfos.emplace(name, std::move(builder));
+      // SAFETY: the emplace above always inserts (this is the
+      // not-found branch), so find() always succeeds. The builder was
+      // moved into the map, so the signature documentation is attached
+      // to the map value; on a fresh builder, set-if-empty is just an
+      // assignment.
+      this->symbolInfos.find(name)
+          ->second.setSignatureDocumentation(
+              symbolInfo.signature_documentation().text());
       continue;
@@ -200,2 +214,4 @@ void DocumentBuilder::merge(scip::Document &&doc) {
         std::move(*symbolInfo.mutable_relationships()));
+    symbolInfoBuilder.setSignatureDocumentation(
+        symbolInfo.signature_documentation().text());
   }
@@ -288,2 +304,9 @@ void IndexBuilder::addExternalSymbolUnchecked(
   this->externalSymbols.emplace(name, std::move(builder));
+  // SAFETY: the emplace above always inserts (this helper is only called
+  // when the symbol isn't present yet), so find() always succeeds. The
+  // builder was moved into the map, so the signature documentation is
+  // attached to the map value.
+  this->externalSymbols.find(name)
+      ->second->setSignatureDocumentation(
+          extSym.signature_documentation().text());
 }
@@ -305,2 +328,3 @@ void IndexBuilder::addExternalSymbol(scip::SymbolInformation &&extSym) {
   builder->mergeRelationships(std::move(*extSym.mutable_relationships()));
+  builder->setSignatureDocumentation(extSym.signature_documentation().text());
 }
diff --git a/indexer/ScipExtras.h b/indexer/ScipExtras.h
index 7250a22..69473e4 100644
--- a/indexer/ScipExtras.h
+++ b/indexer/ScipExtras.h
@@ -90,2 +90,5 @@ class SymbolInformationBuilder final {
   std::vector<std::string> documentation;
+  // Carries SCIP's signature_documentation (SymbolInformation field 7)
+  // through the merge pipeline; empty = absent.
+  std::string signatureDocumentation;
   absl::flat_hash_set<RelationshipExt> relationships;
@@ -107,2 +110,11 @@ public:
 
+  // Adopts newText when the builder has no signature documentation yet:
+  // the first non-empty one wins, and a later duplicate can fill an
+  // earlier empty one (mirrors how documentation is merged).
+  void setSignatureDocumentation(std::string newText) {
+    if (this->signatureDocumentation.empty()) {
+      this->signatureDocumentation = std::move(newText);
+    }
+  }
+
   bool hasDocumentation() const;
