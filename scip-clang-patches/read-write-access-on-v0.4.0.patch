# ReadAccess/WriteAccess syntactic classifier — tags scip::SymbolRole
# WriteAccess on reference sites whose syntactic AST parent is an
# assignment, compound assignment, ++/--, or their overloaded-operator
# forms (with ReadAccess set alongside WriteAccess when the site both
# reads and writes); field references in constructor initializers are
# unconditionally writes. Plain reads stay untagged (a non-definition
# reference without WriteAccess is already implicitly a read).
# Syntactic classification only — no dataflow; see the classifier's own
# doc comment in indexer/Indexer.cc (`classifyAccessRoles`) for scope
# and limits. Fulfills the "TODO: Add read-write access" note upstream
# left in saveDeclRefExpr. NOT (yet) an upstream PR.
#
# Applicability: generated with minimal diff context (`-U1`) so it applies
# cleanly regardless of position relative to the other two patches in this
# directory (or completely alone) — verified empirically: all 6 orderings of
# the three patches applied to a clean v0.4.0 checkout produce byte-identical
# final files. See scip-clang-patches/README.md's "Independence" section.
diff --git a/indexer/Indexer.cc b/indexer/Indexer.cc
index 3155789..3064a7b 100644
--- a/indexer/Indexer.cc
+++ b/indexer/Indexer.cc
@@ -16,2 +16,3 @@
 #include "clang/AST/CXXInheritance.h"
+#include "clang/AST/ParentMapContext.h"
 #include "clang/AST/Comment.h"
@@ -354,2 +355,112 @@ bool RefersToForwardDecl::check(const clang::Decl &decl) {
 
+/// Classifies how a reference site accesses the symbol it denotes, as
+/// SCIP SymbolRole bits (0 = unclassified), based on the syntactic
+/// parent of the expression alone.
+///
+/// Scope and limits (syntactic classification only — no dataflow):
+/// - Plain reads are left untagged: a non-definition reference without
+///   WriteAccess is already implicitly a read. ReadAccess is only set
+///   alongside WriteAccess, where the site both reads and writes the
+///   symbol (compound assignment, ++/--).
+/// - `f(x)` where x is passed by reference to an out-param is not
+///   detected as a write.
+/// - `a.b() = x` is not classified: the classifier does not climb
+///   through calls, since invoking b is not a write to b (and the
+///   object the returned reference aliases is unknowable here).
+/// - `&x` is neither a read nor a write of x: what happens at the
+///   receiving end is unknowable without dataflow.
+/// - `*p = v` correctly leaves p untagged: p itself is only read; the
+///   pointee is written.
+/// - References resolving to a decl-only forward declaration are
+///   routed by saveReference to the ForwardDeclMap pipeline before
+///   role bits could apply; write tagging is not plumbed through that
+///   separate proto (roles are set independently in
+///   ForwardDeclOccurrence::addTo).
+///
+/// When multiple AST parents exist (e.g. around templates), the first
+/// parent is used.
+static int32_t classifyAccessRoles(const clang::Expr &site,
+                                   clang::ASTContext &astContext) {
+  const clang::Expr *current = &site;
+  const clang::Stmt *parent = nullptr;
+  while (true) {
+    auto parents = astContext.getParentMapContext().getParents(*current);
+    if (parents.empty()) {
+      return 0;
+    }
+    parent = parents[0].get<clang::Stmt>();
+    if (!parent) {
+      return 0;
+    }
+    if (auto *cast = llvm::dyn_cast<clang::ImplicitCastExpr>(parent)) {
+      current = cast;
+      continue;
+    }
+    if (auto *paren = llvm::dyn_cast<clang::ParenExpr>(parent)) {
+      current = paren;
+      continue;
+    }
+    break;
+  }
+  const clang::Expr *candidate = nullptr;
+  bool isWrite = false;
+  bool isRead = false;
+  if (auto *binOp = llvm::dyn_cast<clang::BinaryOperator>(parent)) {
+    if (!binOp->isAssignmentOp()) {
+      return 0;
+    }
+    candidate = binOp->getLHS();
+    isWrite = true;
+    isRead = binOp->isCompoundAssignmentOp();
+  } else if (auto *unOp = llvm::dyn_cast<clang::UnaryOperator>(parent)) {
+    // Note: UO_AddrOf falls through to the identity check below and
+    // stays untagged (see limits above).
+    if (!unOp->isIncrementDecrementOp()) {
+      return 0;
+    }
+    candidate = unOp->getSubExpr();
+    isWrite = true;
+    isRead = true;
+  } else if (auto *call =
+                 llvm::dyn_cast<clang::CXXOperatorCallExpr>(parent)) {
+    // Overloaded operators: `s = t`, `s += t`, `it++` — argument 0 is
+    // the object being accessed.
+    if (call->getNumArgs() == 0) {
+      return 0;
+    }
+    candidate = call->getArg(0);
+    switch (call->getOperator()) {
+      case clang::OO_Equal:
+        isWrite = true;
+        break;
+      case clang::OO_PlusEqual:
+      case clang::OO_MinusEqual:
+      case clang::OO_StarEqual:
+      case clang::OO_SlashEqual:
+      case clang::OO_PercentEqual:
+      case clang::OO_AmpEqual:
+      case clang::OO_CaretEqual:
+      case clang::OO_PipeEqual:
+      case clang::OO_LessLessEqual:
+      case clang::OO_GreaterGreaterEqual:
+      case clang::OO_PlusPlus:
+      case clang::OO_MinusMinus:
+        isWrite = true;
+        isRead = true;
+        break;
+      default:
+        return 0;
+    }
+  } else {
+    return 0;
+  }
+  if (candidate->IgnoreParenImpCasts() != &site) {
+    return 0;
+  }
+  if (isRead) {
+    return scip::SymbolRole::WriteAccess | scip::SymbolRole::ReadAccess;
+  }
+  return scip::SymbolRole::WriteAccess;
+}
+
 void ForwardDeclMap::insert(SymbolNameRef symbol, DocComment &&docComment,
@@ -525,3 +636,7 @@ void TuIndexer::saveFieldReference(const clang::FieldDecl &fieldDecl,
   if (auto optSymbol = this->symbolFormatter.getFieldSymbol(fieldDecl)) {
-    this->saveReference(*optSymbol, loc);
+    // A constructor initializer unconditionally writes the field, and
+    // this is the only path field references in ctor initializers take
+    // (there is no MemberExpr to classify).
+    this->saveReference(*optSymbol, loc, /*maybeFwdDecl=*/nullptr,
+                        scip::SymbolRole::WriteAccess);
   }
@@ -1021,4 +1136,4 @@ void TuIndexer::saveDeclRefExpr(const clang::DeclRefExpr &declRefExpr) {
   // ^ getExprLoc()
-  this->saveReference(optSymbol.value(), declRefExpr.getLocation(), foundDecl);
-  // ^ TODO: Add read-write access to the symbol role here
+  this->saveReference(optSymbol.value(), declRefExpr.getLocation(), foundDecl,
+                      classifyAccessRoles(declRefExpr, this->astContext));
 }
@@ -1041,3 +1156,4 @@ void TuIndexer::saveMemberExpr(const clang::MemberExpr &memberExpr) {
   }
-  this->saveReference(optSymbol.value(), memberExpr.getMemberLoc(), namedDecl);
+  this->saveReference(optSymbol.value(), memberExpr.getMemberLoc(), namedDecl,
+                      classifyAccessRoles(memberExpr, this->astContext));
 }
