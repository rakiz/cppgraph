diff --git a/test/index/vars/access.cc b/test/index/vars/access.cc
new file mode 100644
index 0000000..38a33b4
--- /dev/null
+++ b/test/index/vars/access.cc
@@ -0,0 +1,68 @@
+// extra-args: -std=c++17
+
+int counter = 0;
+
+void consume(int &out);
+
+int readGlobal() {
+  return counter; // plain read: untagged
+}
+
+void writeGlobal() {
+  counter = 5;
+}
+
+void compoundWrite() {
+  counter += 1;
+}
+
+void incrementGlobal() {
+  counter++;
+  ++counter;
+  counter--; // cover decrement too
+}
+
+void addressOf() {
+  void *p = &counter; // address-of: untagged
+}
+
+void derefWrite() {
+  *(&counter) = 1; // reads counter, writes the pointee: untagged
+}
+
+void outParam() {
+  consume(counter); // by-reference out-param: untagged (no dataflow)
+}
+
+void chainedAssign() {
+  int a;
+  int b;
+  a = b = 3;
+}
+
+struct Point {
+  int x;
+  int y;
+};
+
+int memberRead(Point &p) {
+  return p.x; // plain member read: untagged
+}
+
+void memberWrite(Point &p) {
+  p.x = 5;
+  (p.y) += 2; // parenthesized compound assignment
+}
+
+struct Accumulator {
+  int n;
+  Accumulator() : n(0) {}          // ctor initializer: write to n
+  explicit Accumulator(int init) : n(init) {}
+  void add(int v) { n += v; }      // read+write to n
+  Accumulator &operator=(const Accumulator &) = default;
+};
+
+void overloadAssign(Accumulator &a, const Accumulator &b) {
+  a = b;    // overloaded operator=: write
+  a.n += 1; // builtin compound assignment on field: read+write
+}
