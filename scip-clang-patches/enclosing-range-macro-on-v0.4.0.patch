# enclosing_range for macro-introduced definitions.
#
# Requires: enclosing_range-on-v0.4.0.patch
#
# PR #504's enclosing_range is skipped for a definition introduced through a
# macro: the definition's declaration range is cross-file (its begin is the
# macro's spelling location), so the same-file guard drops it. getEnclosingRange
# falls back to the function body extent — written where the definition is, so
# single-file; anything still cross-file yields an empty range (no
# enclosing_range, an optional field).
#
# Applicability: requires enclosing_range-on-v0.4.0.patch (PR #504), whose
# saveDefinition(...) arguments it rewrites; order-independent with respect to
# the other five patches in this directory (it touches no line any of them
# touches) and generated with minimal diff context (`-U1`). See
# scip-clang-patches/README.md's "Independence" section.
diff --git a/indexer/Indexer.cc b/indexer/Indexer.cc
index c63040b..b6f47ae 100644
--- a/indexer/Indexer.cc
+++ b/indexer/Indexer.cc
@@ -457,3 +457,3 @@
   this->saveDefinition(optSymbol.value(), bindingDecl.getLocation(),
-                       std::nullopt, 0, bindingDecl.getSourceRange());
+                       std::nullopt, 0, this->getEnclosingRange(bindingDecl));
 }
@@ -479,3 +479,3 @@
                        std::move(symbolInfo), 0,
-                       enumConstantDecl.getSourceRange());
+                       this->getEnclosingRange(enumConstantDecl));
 }
@@ -517,3 +517,3 @@
   this->saveDefinition(optSymbol.value(), fieldDecl.getLocation(), symbolInfo,
-                       0, fieldDecl.getSourceRange());
+                       0, this->getEnclosingRange(fieldDecl));
 }
@@ -563,3 +563,3 @@
                          std::move(symbolInfo), 0,
-                         functionDecl.getSourceRange());
+                         this->getEnclosingRange(functionDecl));
   } else {
@@ -618,3 +618,3 @@
