+bool TuIndexer::isSingleFileSourceRange(clang::SourceRange range) const {
+  if (!range.isValid()) {
+    return false;
+  }
+  auto begin = range.getBegin();
+  auto end = range.getEnd();
+  if (!begin.isValid() || !end.isValid()) {
+    return false;
+  }
+  return this->sourceManager.getFileID(begin)
+         == this->sourceManager.getFileID(end);
+}
+
+clang::SourceRange TuIndexer::getEnclosingRange(const clang::Decl &decl) const {
+  clang::SourceRange range = decl.getSourceRange();
+  if (this->isSingleFileSourceRange(range)) {
+    return range;
+  }
+  // Macro-decorated declaration ranges are cross-file, so use the body instead.
+  if (const auto *fn = llvm::dyn_cast<clang::FunctionDecl>(&decl)) {
+    // getBody() follows redeclarations; require this declaration to own the body.
+    if (fn->doesThisDeclarationHaveABody()) {
+      if (const clang::Stmt *body = fn->getBody()) {
+        clang::SourceRange bodyRange = body->getSourceRange();
+        if (this->isSingleFileSourceRange(bodyRange)) {
+          return bodyRange;
+        }
+      }
+    }
+  }
+  // No single-file extent: record none; the field is optional.
+  return {};
+}
+
