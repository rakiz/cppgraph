# SymbolInformation.kind — fills SCIP's SymbolInformation::Kind (field 5),
# which upstream leaves at UnspecifiedKind on 100% of symbols. A syntactic
# classifier (`classifySymbolKind` in indexer/Indexer.cc, same style as
# read-write-access's `classifyAccessRoles`) maps the clang::Decl at each
# SymbolInformation-creating site to its SCIP kind: Class/Struct/Union/Enum
# (via TagDecl::getTagKind), EnumMember, Field, Function / Method /
# StaticMethod / PureVirtualMethod / Constructor (FunctionDecl shape),
# Variable / StaticDataMember (VarDecl), Namespace, TypeAlias; macros get
# Macro and synthetic file symbols get File. The kind is carried through
# the TU-merge pipeline: SymbolInformationBuilder gains a `kind` field
# (captured from the raw per-TU SymbolInformation at merge time, defaulted
# to UnspecifiedKind) and re-emits it in finish(). Symbols which get no
# SymbolInformation today (local variables, parameters, template type
# parameters) are unaffected — see the classifier's doc comment for scope
# and limits. NOT (yet) an upstream PR.
#
# Applicability: generated with minimal diff context (`-U1`) so it applies
# cleanly in any order relative to the other three patches in this directory
# (or completely alone) — verified empirically: all 24 orderings of the four
# patches applied to a clean v0.4.0 checkout produce byte-identical final
# files. See scip-clang-patches/README.md's "Independence" section.
diff --git a/indexer/Indexer.cc b/indexer/Indexer.cc
index 79560fb..033760b 100644
--- a/indexer/Indexer.cc
+++ b/indexer/Indexer.cc
@@ -109,2 +109,72 @@ void FileLocalMacroOccurrence::emitOccurrence(SymbolFormatter &symbolFormatter,
 
+/// Classifies a declaration into SCIP's SymbolInformation::Kind (0 =
+/// UnspecifiedKind when no SCIP kind fits well), based on the shape of
+/// the declaration alone.
+///
+/// Scope and limits (syntactic classification only — no semantic
+/// analysis):
+/// - Only declarations which get a SymbolInformation emitted for them
+///   today are classified at the call sites; the arms for local
+///   variables and parameters exist for completeness, since those are
+///   currently emitted without a SymbolInformation.
+/// - Using-shadow declarations, template type parameters and concepts
+///   are left unclassified (UnspecifiedKind).
+/// - Destructors classify as Method (SCIP has no Destructor kind), and
+///   a C++ record declared with the `class` keyword as Class regardless
+///   of access defaults; `__interface` classifies as Interface.
+static scip::SymbolInformation::Kind
+classifySymbolKind(const clang::Decl &decl) {
+  if (auto *functionDecl = llvm::dyn_cast<clang::FunctionDecl>(&decl)) {
+    if (llvm::isa<clang::CXXConstructorDecl>(functionDecl)) {
+      return scip::SymbolInformation::Constructor;
+    }
+    if (functionDecl->isPureVirtual()) {
+      return scip::SymbolInformation::PureVirtualMethod;
+    }
+    if (auto *methodDecl = llvm::dyn_cast<clang::CXXMethodDecl>(functionDecl)) {
+      return methodDecl->isStatic()
+                 ? scip::SymbolInformation::StaticMethod
+                 : scip::SymbolInformation::Method;
+    }
+    return scip::SymbolInformation::Function;
+  }
+  if (auto *varDecl = llvm::dyn_cast<clang::VarDecl>(&decl)) {
+    if (llvm::isa<clang::ParmVarDecl>(varDecl)) {
+      return scip::SymbolInformation::Parameter;
+    }
+    if (varDecl->isStaticDataMember()) {
+      return scip::SymbolInformation::StaticDataMember;
+    }
+    return scip::SymbolInformation::Variable;
+  }
+  if (auto *tagDecl = llvm::dyn_cast<clang::TagDecl>(&decl)) {
+    switch (tagDecl->getTagKind()) {
+      case clang::TagTypeKind::Class:
+        return scip::SymbolInformation::Class;
+      case clang::TagTypeKind::Enum:
+        return scip::SymbolInformation::Enum;
+      case clang::TagTypeKind::Interface:
+        return scip::SymbolInformation::Interface;
+      case clang::TagTypeKind::Struct:
+        return scip::SymbolInformation::Struct;
+      case clang::TagTypeKind::Union:
+        return scip::SymbolInformation::Union;
+    }
+    return scip::SymbolInformation::UnspecifiedKind;
+  }
+  if (llvm::isa<clang::EnumConstantDecl>(&decl)) {
+    return scip::SymbolInformation::EnumMember;
+  }
+  if (llvm::isa<clang::FieldDecl>(&decl)) {
+    return scip::SymbolInformation::Field;
+  }
+  if (llvm::isa<clang::NamespaceDecl>(&decl)) {
+    return scip::SymbolInformation::Namespace;
+  }
+  if (llvm::isa<clang::TypedefNameDecl>(&decl)) {
+    return scip::SymbolInformation::TypeAlias;
+  }
+  return scip::SymbolInformation::UnspecifiedKind;
+}
