+/// Resolves a field or variable's declared type to the NamedDecl that a
+/// Relationship.is_type_definition edge should point at, reusing the exact
+/// type-resolution policy of trySaveTypeReference: a typedef/alias type
+/// resolves to the typedef declaration, a tag type to the tag declaration,
+/// and a template specialization to the primary templated declaration (so a
+/// field of std::vector<Foo> gets a single edge to std::vector; template
+/// arguments are not followed). Pointer, reference and cv-qualifier wrappers
+/// are stripped first, e.g. `const Foo&` resolves to Foo.
+///
+/// Returns nullptr when there is no compiler-resolved SCIP symbol to point
+/// at — builtin types, `auto` without a resolvable named declaration,
+/// dependent types, or any other shape the policy above doesn't classify —
+/// and callers emit no relationship at all in that case (only exact,
+/// compiler-traced facts, never a guessed one).
+static const clang::NamedDecl *
+tryResolveDeclaredTypeDecl(clang::QualType declaredType) {
+  if (declaredType.isNull()) {
+    return nullptr;
+  }
+  while (declaredType->isPointerType() || declaredType->isReferenceType()) {
+    declaredType = declaredType->getPointeeType();
+  }
+  declaredType = declaredType.getUnqualifiedType();
+  const clang::Type *type = declaredType.getTypePtr();
+  if (auto *typedefType = llvm::dyn_cast<clang::TypedefType>(type)) {
+    return typedefType->getDecl();
+  }
+  if (auto *tagDecl = type->getAsTagDecl()) {
+    return tagDecl;
+  }
+  if (auto *templateSpecializationType =
+          llvm::dyn_cast<clang::TemplateSpecializationType>(type)) {
+    if (auto *templateDecl =
+            templateSpecializationType->getTemplateName().getAsTemplateDecl()) {
+      return templateDecl->getTemplatedDecl();
+    }
+  }
+  return nullptr;
+}
+
+void TuIndexer::saveTypeDefinitionRelationship(
+    const clang::NamedDecl &decl, clang::QualType declaredType) {
+  // Relationship.is_type_definition ("go to type definition") — see
+  // tryResolveDeclaredTypeDecl above for the resolution policy and the
+  // cases which silently emit no relationship.
+  //
+  // Scope (accepted v1 limitation, mirroring the kind patch's): only
+  // declarations which get a SymbolInformation emitted today — fields
+  // (saveFieldDecl) and file-scope variables / static data members
+  // (saveVarDecl's SymbolInformation branch). Local variables, parameters
+  // and local extern declarations take the saveDefinition(std::nullopt,
+  // ...) or saveReference-only paths and have no SymbolInformation to
+  // attach a relationship to; this deliberately does NOT extend
+  // SymbolInformation emission to them.
+  if (auto *varDecl = llvm::dyn_cast<clang::VarDecl>(&decl)) {
+    if (varDecl->isLocalVarDeclOrParm() || varDecl->isLocalExternDecl()
+        || !(varDecl->isStaticDataMember() || varDecl->isFileVarDecl())) {
+      return;
+    }
+  }
+  auto optDeclSymbol = this->symbolFormatter.getNamedDeclSymbol(decl);
+  if (!optDeclSymbol.has_value()) {
+    return;
+  }
+  auto *typeDecl = tryResolveDeclaredTypeDecl(declaredType);
+  if (!typeDecl) {
+    return;
+  }
+  auto optTypeSymbol = this->symbolFormatter.getNamedDeclSymbol(*typeDecl);
+  if (!optTypeSymbol.has_value()) {
+    return;
+  }
+  // Same file guards as saveDefinition: the relationship rides along with
+  // the declaration's own SymbolInformation, which is only emitted for
+  // in-project files.
+  auto expansionLoc = this->sourceManager.getExpansionLoc(decl.getLocation());
+  auto fileId = this->sourceManager.getFileID(expansionLoc);
+  if (!this->fileIdsToBeIndexed.contains({fileId})) {
+    return;
+  }
+  auto optStableFileId = this->fileMetadataMap.getStableFileId(fileId);
+  if (!optStableFileId.has_value() || !optStableFileId->isInProject) {
+    return;
+  }
+  // Emitted as a standalone SymbolInformation, kept out of the per-symbol
+  // map in PartialDocument so it can never displace the declaration's
+  // primary SymbolInformation. TuIndexer::emitDocumentOccurrencesAndSymbols
+  // later folds this relationship into the matching primary
+  // SymbolInformation (looked up by symbol name) before either is emitted,
+  // so the final index has the relationship on the field's / variable's
+  // own SymbolInformation, not on a separate duplicate entry.
+  auto &doc = this->documentMap[{fileId}];
+  scip::SymbolInformation symbolInfo{};
+  auto declSymbol = optDeclSymbol->value;
+  symbolInfo.set_symbol(declSymbol.data(), declSymbol.size());
+  scip::Relationship rel{};
+  auto typeSymbol = optTypeSymbol->value;
+  rel.set_symbol(typeSymbol.data(), typeSymbol.size());
+  rel.set_is_type_definition(true);
+  *symbolInfo.add_relationships() = std::move(rel);
+  doc.extraSymbolInfos.push_back(std::move(symbolInfo));
+}
